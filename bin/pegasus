#!/bin/bash

PEGASUS_PATH="${PEGASUS_PATH:-$HOME/.local/share/pegasus}"
[ ! -d "$PEGASUS_PATH" ] && PEGASUS_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Installation must work even when gum is not installed yet.
if [ "${1:-}" = install ]; then
  shift
  exec "$PEGASUS_PATH/scripts/installer.sh" "$@"
fi

# Ensure gum is available for interactive commands
if ! command -v gum >/dev/null 2>&1; then
  if [ -f "$PEGASUS_PATH/install/terminal/required/app-gum.sh" ]; then
    source "$PEGASUS_PATH/install/terminal/required/app-gum.sh" >/dev/null 2>&1 || true
  fi
  if ! command -v gum >/dev/null 2>&1; then
    echo "Error: 'gum' is required for Pegasus CLI but could not be found."
    echo "Please install 'gum' or re-run install.sh."
    exit 1
  fi
fi

case "${1:-}" in

  "doctor")
    source "$PEGASUS_PATH/scripts/doctor.sh"
    exit 0
    ;;
  "theme")
    shift
    source "$PEGASUS_PATH/bin/pegasus-sub/theme.sh" "$@"
    exit 0
    ;;
  "font")
    shift
    source "$PEGASUS_PATH/bin/pegasus-sub/font.sh" "$@"
    exit 0
    ;;
  "update")
    source "$PEGASUS_PATH/update.sh"
    exit 0
    ;;
  "uninstall")
    source "$PEGASUS_PATH/uninstall.sh"
    exit 0
    ;;
esac

source "$PEGASUS_PATH/bin/pegasus-sub/header.sh" 2>/dev/null || true
source "$PEGASUS_PATH/bin/pegasus-sub/menu.sh" 2>/dev/null || true
